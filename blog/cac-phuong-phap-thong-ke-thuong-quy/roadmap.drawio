        <mxCell id="nUqFJHozvEOeFcWw0bwK-37" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=7.874;spacingRight=7.874;spacingTop=7.874;spacingBottom=7.874;fontColor=#000000;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;R được xây dựng trên các lệnh tính toán thống kê theo trường phái Frequentist (tần suất) là trường phái chủ đạo trong xác suất thống kê&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;(tìm hiểu Sir Ronald Fisher tranh luận về trường phái Bayesian).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;&quot;&gt;Các kiểm định giả thuyết này có một phiên bản tương đương theo cách tiếp cận Bayesian. Bạn có thể học song song, hoặc nắm chắc cách tiếp cận Frequentist để hiểu căn bản về lập luận thống kê truyền thống rồi từ đó đối chiếu với trường phái Bayesian. Hai cách tiếp cận này nhìn vấn đề xác suất ở 2 lăng kính khác nhau trên cùng 1 bộ dữ liệu.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="320" x="-441.33" y="580.39" as="geometry" />
        </mxCell>
        <UserObject label="Home" link="https://thongkevavedothi.com/" id="rCSKf9rMT3vSiaWQK2rG-4">
          <mxCell parent="1" style="labelPosition=center;verticalLabelPosition=middle;align=center;html=1;shape=mxgraph.basic.shaded_button;dx=10;fillColor=#d80073;strokeColor=#A50040;whiteSpace=wrap;fontColor=#ffffff;" vertex="1">
            <mxGeometry height="40" width="80" x="-441.33" y="80" as="geometry" />
          </mxCell>
        </UserObject>
