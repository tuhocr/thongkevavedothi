        </UserObject>
        <mxCell id="rCSKf9rMT3vSiaWQK2rG-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;font&gt;Tổng quan về các phương pháp thống kê thường quy trong nghiên cứu khoa học&lt;/font&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font&gt;Biên soạn: Duc Nguyen | tuhocr.com&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;[&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;2026-08-29]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Mục tiêu của sơ đồ này là tổng quan toàn bộ các kỹ thuật phân tích dữ liệu thống kê, kèm theo đường link đến các hướng dẫn chạy bằng R, phục vụ việc áp dụng R hiệu quả vào công việc.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="320" x="-441.33" y="200" as="geometry" />
        </mxCell>
