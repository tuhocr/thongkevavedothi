          <mxCell parent="1" style="labelPosition=center;verticalLabelPosition=middle;align=center;html=1;shape=mxgraph.basic.shaded_button;dx=10;fillColor=#0050ef;strokeColor=#001DBC;whiteSpace=wrap;fontColor=#ffffff;" vertex="1">
